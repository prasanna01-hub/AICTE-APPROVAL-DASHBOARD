# =================================================================
# AICTE APPROVAL & COMPLIANCE AUTOMATION SYSTEM - ENV VARIABLES
# =================================================================

# Node.js Express Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=aicte_workflow_db
# PostgreSQL Connection URL string (for ORM or pg pool)
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/aicte_workflow_db

# Python FastAPI Microservice Configuration
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_PORT=8000

# Authentication & Security
JWT_SECRET=aicte_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=24h

# Document Storage Configuration
DOC_UPLOAD_DIR="./uploads/documents"
MAX_FILE_SIZE_MB=10

# Notification & SMTP Server (For Email Alerts)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
ALERT_FROM_EMAIL=notifications@aicte-india.org

# Gemini AI API Key (Injected automatically in AI Studio runtime)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
