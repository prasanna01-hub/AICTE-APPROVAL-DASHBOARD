# =================================================================
# AICTE APPROVAL & COMPLIANCE AUTOMATION SYSTEM — PRODUCTION ENV
# =================================================================
# Copy this file to `.env.production` (or paste the values into the
# Vercel / Render dashboards). Never commit real secrets.

# --- Server -------------------------------------------------------
NODE_ENV=production
# Render/Heroku inject PORT automatically — do not hardcode it there.
PORT=3000
APP_URL="https://your-frontend.vercel.app"

# --- Security -----------------------------------------------------
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=24h

# Comma separated list of allowed browser origins.
# Use * while testing, then lock it down to your Vercel URL.
CORS_ORIGINS=*

# --- Python FastAPI ML microservice (optional) --------------------
# Leave default to use the built-in TypeScript prediction engine.
AI_SERVICE_URL="http://localhost:8000"

# --- Document storage ---------------------------------------------
DOC_UPLOAD_DIR="./uploads/documents"
MAX_FILE_SIZE_MB=10

# --- Notification / SMTP (optional) -------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=notifications@aicte-india.org

# --- Gemini AI (optional) -----------------------------------------
GEMINI_API_KEY=""

# =================================================================
# FRONTEND (Vercel) — build time variable
# =================================================================
# Leave EMPTY when the frontend and API share a domain (Vercel rewrite).
# Set it to the deployed API origin (no trailing slash) when the backend
# is hosted separately, e.g. on Render:
#   VITE_API_BASE_URL="https://aicte-approval-api.onrender.com/api"
VITE_API_BASE_URL=""
